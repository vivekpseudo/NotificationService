# Never commit actual values. Generate a shared random secret and configure it identically in both services.
DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
ALLOWED_HOSTS=localhost,127.0.0.1,web,host.docker.internal
OKR_NOTIFICATION_SHARED_SECRET=replace-with-at-least-32-random-characters
# Slack bot token with least-privilege chat:write scope (optional until Slack is configured).
SLACK_BOT_TOKEN=xoxb-replace-me
